# Never commit the real Home Assistant long-lived access token.
HA_URL=http://10.0.50.7:8123
HA_TOKEN=COLLER_ICI_LE_JETON_HOME_ASSISTANT
HOST=127.0.0.1
PORT=3001
# Optional: protects inventory and service calls with Authorization: Bearer <token>.
CITADEL_CLIENT_TOKEN=
# Comma-separated trusted browser origins. Leave blank when Nginx serves same-origin.
CORS_ORIGIN=
# Optional display allow-list. Leave unset to use the supplied starting entities.
# CITADEL_ENTITIES=light.salon,light.ampoule_bureau
